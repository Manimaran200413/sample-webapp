<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         version="5.0">

    <display-name>Sample Web Application</display-name>
    <description>A modern Java web application deployed on Apache Tomcat</description>

    <!-- ================================================ -->
    <!--  Welcome Files                                    -->
    <!-- ================================================ -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ================================================ -->
    <!--  Servlets                                        -->
    <!-- ================================================ -->

    <!-- Home Servlet -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.sampleapp.servlet.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <!-- About Servlet -->
    <servlet>
        <servlet-name>AboutServlet</servlet-name>
        <servlet-class>com.sampleapp.servlet.AboutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AboutServlet</servlet-name>
        <url-pattern>/about</url-pattern>
    </servlet-mapping>

    <!-- Services Servlet -->
    <servlet>
        <servlet-name>ServicesServlet</servlet-name>
        <servlet-class>com.sampleapp.servlet.ServicesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServicesServlet</servlet-name>
        <url-pattern>/services</url-pattern>
    </servlet-mapping>

    <!-- Contact Servlet -->
    <servlet>
        <servlet-name>ContactServlet</servlet-name>
        <servlet-class>com.sampleapp.servlet.ContactServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ContactServlet</servlet-name>
        <url-pattern>/contact</url-pattern>
    </servlet-mapping>

    <!-- ================================================ -->
    <!--  Error Pages                                      -->
    <!-- ================================================ -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error500.jsp</location>
    </error-page>

    <!-- ================================================ -->
    <!--  Session Configuration                            -->
    <!-- ================================================ -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
